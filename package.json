{
  "name": "20factor-analyser",
  "version": "3.1.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "description": "Vahini 20-Factor Handwriting Analyser \u2014 deterministic computer-vision handwriting analysis with a pluggable OCR backend.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vahinitech/20factor-analyser.git"
  },
  "scripts": {
    "build:bundle": "python frontend/build_bundle.py",
    "test:regression:serve": "http-server . -p 4173 -c-1",
    "test:regression:headless": "node tests/regression-headless.mjs",
    "test:recognition": "node tests/e2e-recognition.mjs",
    "test:regression:install": "playwright install chromium",
    "test:pdf": "node tests/pdf-upload.mjs",
    "test:unreadable": "node tests/unreadable-image.mjs",
    "test:keep": "node tests/keep-my-pages.mjs",
    "test:daily-limit": "node tests/daily-limit.mjs",
    "test:ocr-unavailable": "node tests/ocr-unavailable.mjs",
    "test:check-dropped": "node tests/check-dropped.mjs",
    "test:handwriting-not-read": "node tests/handwriting-not-read.mjs",
    "test:telugu-choice": "node tests/telugu-choice.mjs",
    "test:notice-art": "node tests/notice-art.mjs",
    "test:not-writing-page": "node tests/not-writing-page.mjs",
    "test:turned-page": "node tests/turned-page.mjs",
    "sbom:update": "python backend/tools/update_sbom.py",
    "sbom:check": "python backend/tools/update_sbom.py --check",
    "test:practice": "node tests/practice-report.mjs",
    "test:words": "node tests/report-words.test.mjs",
    "test:language": "node tests/report-language.mjs",
    "test:student-view": "node tests/student-view.mjs",
    "test:strings": "node tests/report-strings.test.mjs",
    "test:print-popup": "node tests/print-popup.mjs",
    "test:report-feedback": "node tests/report-feedback.mjs",
    "test:share-embed": "node tests/report-share-embed.mjs",
    "test:unit": "for t in tests/*.test.mjs; do echo \"== $t\"; node \"$t\" || exit 1; done",
    "coverage:frontend": "c8 npm run -s test:unit"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0"
  }
}
