{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/health.schema.json",
  "title": "GET /health response",
  "type": "object",
  "required": [
    "ok",
    "engine",
    "ocr_backend",
    "active_backend",
    "backends",
    "gpu",
    "gpu_detected",
    "langs",
    "ocr_version"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "engine": {
      "type": "string"
    },
    "ocr_backend": {
      "type": "string"
    },
    "active_backend": {
      "type": "string"
    },
    "backends": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ready",
          "reason"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gpu": {
      "type": "boolean"
    },
    "gpu_detected": {
      "type": "boolean"
    },
    "gpu_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "langs": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "integer",
      "minimum": 0
    },
    "ocr_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "null when VAHINI_OCR_VERSION is set to an empty value."
    },
    "det_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "rec_model_map": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "det_limit_side_len": {
      "type": [
        "integer",
        "null"
      ]
    },
    "printed_threshold": {
      "type": "number"
    },
    "adaptive_engine_speed": {
      "type": "object"
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages_sha256",
        "devices"
      ],
      "properties": {
        "stages_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of backend/languages/stages.json, the table every recognition route comes from."
        },
        "devices": {
          "type": "object",
          "description": "The device each registered engine resolved to; null until the engine is built.",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "debug_store": {
      "type": "boolean",
      "description": "true only on stage with debug storage provisioned: photos and answers are being kept (SECURITY.md)."
    },
    "report_store": {
      "type": "boolean",
      "description": "true when report records are kept for later comparison: scores and counts, never a photo or the words read (backend/report_store.py)."
    },
    "layout_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "built_tiers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "built_tiers": {
          "type": "array"
        }
      }
    },
    "stage_timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scans",
        "window",
        "stages",
        "budget_breaches"
      ],
      "properties": {
        "scans": {
          "type": "integer",
          "minimum": 0
        },
        "window": {
          "type": "integer",
          "minimum": 1
        },
        "stages": {
          "type": "object",
          "description": "Each stage's milliseconds over the last window scans (backend/perf.py).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "samples",
              "wall_ms_p50",
              "wall_ms_p95",
              "cpu_ms_p50",
              "cpu_ms_p95"
            ],
            "properties": {
              "samples": {
                "type": "integer",
                "minimum": 1
              },
              "wall_ms_p50": {
                "type": "number"
              },
              "wall_ms_p95": {
                "type": "number"
              },
              "cpu_ms_p50": {
                "type": "number"
              },
              "cpu_ms_p95": {
                "type": "number"
              }
            }
          }
        },
        "budget_breaches": {
          "type": "object",
          "description": "Pages over a budget in backend/perf/budgets.json since the server started, by budget:stage. Counted, never refused.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "description": "Stage timings of the scans since the server started, in memory: numbers only (#229)."
    }
  }
}
