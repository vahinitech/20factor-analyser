{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "score_scale",
    "normalized_scale",
    "statuses",
    "bands",
    "factors",
    "sections",
    "limitations",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
    },
    "score_scale": {
      "const": [
        0,
        10
      ]
    },
    "normalized_scale": {
      "const": [
        0,
        100
      ]
    },
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "e",
        "p",
        "m",
        "u"
      ],
      "properties": {
        "e": {
          "const": "estimated"
        },
        "p": {
          "const": "proxy"
        },
        "m": {
          "const": "measured"
        },
        "u": {
          "const": "unavailable"
        }
      }
    },
    "bands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "minimum"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/band"
          },
          "minimum": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "factors": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "id",
          "name",
          "section",
          "reason",
          "exercise",
          "target",
          "instruction",
          "limitation"
        ],
        "properties": {
          "n": {
            "$ref": "common.schema.json#/definitions/factorNumber"
          },
          "id": {
            "$ref": "common.schema.json#/definitions/factorId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "$ref": "common.schema.json#/definitions/sectionId"
          },
          "reason": {
            "type": "string"
          },
          "exercise": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "limitation": {
            "type": [
              "string",
              "null"
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Why the skill helps, one short sentence."
          },
          "win": {
            "type": "string",
            "minLength": 1,
            "description": "A small win the child can see, finishing \"You'll know it's working when ...\"."
          },
          "page": {
            "type": "string",
            "pattern": "^handwriting-[a-z-]+$",
            "description": "The skill's page on vahinitech.com, without '.html'."
          },
          "i18n": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^[a-z]{2}$": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "why",
                  "win"
                ],
                "properties": {
                  "why": {
                    "type": "string",
                    "minLength": 1
                  },
                  "win": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "description": "Translations by language code. A missing language or field falls back to the English text. Latin practice text stays as written, so 'example' is translated only when it is not Latin practice."
          },
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "level",
                "title",
                "unit",
                "script",
                "needs",
                "worksheet",
                "steps",
                "example",
                "check"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]+\\.[a-z0-9-]+$"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "row",
                    "sentence",
                    "word",
                    "line",
                    "letter",
                    "page"
                  ]
                },
                "script": {
                  "type": "string",
                  "enum": [
                    "any",
                    "latin"
                  ]
                },
                "needs": {
                  "type": "string",
                  "enum": [
                    "photo",
                    "pen"
                  ]
                },
                "worksheet": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z0-9-]+$"
                },
                "steps": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "example": {
                  "type": "string"
                },
                "check": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "enum": [
                    "ladder",
                    "zones",
                    "baseline",
                    "gaps",
                    "letter-gaps",
                    "margin",
                    "slant",
                    "loops",
                    "trace",
                    "start-dots",
                    "pairs",
                    "waves",
                    "page"
                  ],
                  "description": "The drawing the report shows under 'Copy this'."
                },
                "helps": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^([1-9]|1[0-9]|20)$": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "description": "How much this entry develops each skill, 0 to 1, by factor number. Its own factor is 1.0 and every other weight is lower. Empty for the spelling row. Catalogues before version 2026-10-11 carry no helps."
                },
                "i18n": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^[a-z]{2}$": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "title",
                        "steps",
                        "check"
                      ],
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "steps": {
                          "type": "string",
                          "minLength": 1
                        },
                        "check": {
                          "type": "string",
                          "minLength": 1
                        },
                        "example": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "description": "Translations by language code. A missing language or field falls back to the English text. Latin practice text stays as written, so 'example' is translated only when it is not Latin practice."
                }
              }
            }
          },
          "tips": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]+\\.[a-z0-9-]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "helps": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^([1-9]|1[0-9]|20)$": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "description": "How much this entry develops each skill, 0 to 1, by factor number. Its own factor is 1.0 and every other weight is lower. Empty for the spelling row. Catalogues before version 2026-10-11 carry no helps."
                },
                "i18n": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^[a-z]{2}$": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "description": "Translations by language code. A missing language or field falls back to the English text. Latin practice text stays as written, so 'example' is translated only when it is not Latin practice."
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "n": {
                  "const": 1
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "letter_formation"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 2
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "stroke_order"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 3
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "loop_closure"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 4
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "line_quality"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 5
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "size_consistency"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 6
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "ascender_descender_control"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 7
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "baseline_alignment"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 8
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "word_spacing"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 9
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "letter_spacing"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 10
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "margin_discipline"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 11
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "line_straightness"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 12
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "vertical_alignment"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 13
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "speed_consistency"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 14
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "pressure_consistency"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 15
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "stroke_continuity"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 16
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "pen_lift_frequency"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 17
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "slant_consistency"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 18
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "legibility"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 19
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "character_distinction"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "const": 20
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "const": "overall_neatness"
                }
              }
            }
          }
        ]
      },
      "description": "Exactly one entry for each factor 1 to 20.",
      "allOf": [
        {
          "contains": {
            "properties": {
              "n": {
                "const": 1
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 2
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 3
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 4
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 5
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 6
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 7
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 8
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 9
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 10
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 11
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 12
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 13
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 14
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 15
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 16
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 17
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 18
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 19
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "n": {
                "const": 20
              }
            }
          }
        }
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "weight"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/sectionId"
          },
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "limitations": {
      "$ref": "common.schema.json#/definitions/limitations"
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "dosage",
        "tiers",
        "units",
        "spelling"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "band",
              "minimum"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "learning",
                  "improving",
                  "mastering",
                  "strong"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "band": {
                "$ref": "common.schema.json#/definitions/band"
              },
              "minimum": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        },
        "dosage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focus",
            "dev",
            "good",
            "strong"
          ],
          "properties": {
            "focus": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tries",
                "per",
                "days",
                "recheck_days",
                "exercises"
              ],
              "properties": {
                "tries": {
                  "type": "integer",
                  "minimum": 1
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week"
                  ]
                },
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "recheck_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "exercises": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "dev": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tries",
                "per",
                "days",
                "recheck_days",
                "exercises"
              ],
              "properties": {
                "tries": {
                  "type": "integer",
                  "minimum": 1
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week"
                  ]
                },
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "recheck_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "exercises": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "good": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tries",
                "per",
                "days",
                "recheck_days",
                "exercises"
              ],
              "properties": {
                "tries": {
                  "type": "integer",
                  "minimum": 1
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week"
                  ]
                },
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "recheck_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "exercises": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "strong": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tries",
                "per",
                "days",
                "recheck_days",
                "exercises"
              ],
              "properties": {
                "tries": {
                  "type": "integer",
                  "minimum": 1
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week"
                  ]
                },
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "recheck_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "exercises": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "free",
            "pro"
          ],
          "properties": {
            "free": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "areas_max",
                "exercises_max",
                "tips_max"
              ],
              "properties": {
                "areas_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "exercises_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "tips_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              },
              "description": "How many skills get practice in one report, and how many exercises and tips each shows, for the caller's tier (practice_catalog.TIERS)."
            },
            "pro": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "areas_max",
                "exercises_max",
                "tips_max"
              ],
              "properties": {
                "areas_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "exercises_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "tips_max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              },
              "description": "How many skills get practice in one report, and how many exercises and tips each shows, for the caller's tier (practice_catalog.TIERS)."
            }
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "row",
              "sentence",
              "word",
              "line",
              "letter",
              "page"
            ]
          }
        },
        "spelling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exercises",
            "tips"
          ],
          "properties": {
            "exercises": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
