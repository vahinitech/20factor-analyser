{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/report-compact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "catalog_version",
    "ok",
    "access",
    "summary",
    "factors",
    "locked"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "format": {
      "const": "compact"
    },
    "catalog_version": {
      "$ref": "common.schema.json#/definitions/catalogVersion"
    },
    "ok": {
      "type": "boolean"
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "plan_tier",
        "subscription_status",
        "expires_at"
      ],
      "properties": {
        "tier": {
          "$ref": "common.schema.json#/definitions/tier"
        },
        "plan_tier": {
          "$ref": "common.schema.json#/definitions/tier"
        },
        "subscription_status": {
          "$ref": "common.schema.json#/definitions/subscriptionStatus"
        },
        "expires_at": {
          "$ref": "common.schema.json#/definitions/unixSeconds"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "factor_count"
      ],
      "properties": {
        "score": {
          "$ref": "common.schema.json#/definitions/scoreOutOfHundred"
        },
        "factor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "factors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "s",
          "st"
        ],
        "properties": {
          "n": {
            "$ref": "common.schema.json#/definitions/factorNumber"
          },
          "s": {
            "$ref": "common.schema.json#/definitions/scoreOutOfTen"
          },
          "st": {
            "$ref": "common.schema.json#/definitions/statusCode"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "st": {
                  "const": "u"
                }
              }
            },
            "then": {
              "properties": {
                "s": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "s": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "n": {
                  "enum": [
                    2,
                    13,
                    14,
                    16
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "st": {
                  "enum": [
                    "p",
                    "m",
                    "u"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "st": {
                  "enum": [
                    "e",
                    "m",
                    "u"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "locked": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/factorNumber"
      },
      "uniqueItems": true,
      "maxItems": 15
    },
    "text": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "level",
        "confidence_pct",
        "mean_confidence",
        "hand_lines",
        "printed_lines",
        "reliable_lines",
        "assistive_only",
        "passage_aligned"
      ],
      "properties": {
        "backend": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/backend"
        },
        "level": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/level"
        },
        "confidence_pct": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/confidence_pct"
        },
        "mean_confidence": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/mean_confidence"
        },
        "hand_lines": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/hand_lines"
        },
        "printed_lines": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/printed_lines"
        },
        "reliable_lines": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/reliable_lines"
        },
        "assistive_only": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/assistive_only"
        },
        "passage_aligned": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/passage_aligned"
        }
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-9]|20)$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence",
          "basis",
          "values"
        ],
        "properties": {
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "values": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "coaching": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/definitions/coachingCard"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "factor_regions"
      ],
      "properties": {
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "factor_regions": {
          "$ref": "common.schema.json#/definitions/factorRegions"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "title": "POST /api/v2/reports?format=compact response (schema 2.1)",
  "description": "Scores only; names, explanations and bands come from GET /api/v2/catalog/{catalog_version}. Optional blocks appear only when requested with include= and allowed by the tier.",
  "dependencies": {
    "counts": [
      "text"
    ],
    "recognition": [
      "text"
    ],
    "text": [
      "counts",
      "recognition"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "properties": {
          "error": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "access": {
            "properties": {
              "tier": {
                "const": "free"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "inputs": false,
          "coaching": false,
          "evidence": false,
          "factors": {
            "maxItems": 5,
            "items": {
              "properties": {
                "n": {
                  "enum": [
                    1,
                    5,
                    7,
                    8,
                    18
                  ]
                }
              }
            }
          },
          "locked": {
            "minItems": 15,
            "items": {
              "$ref": "common.schema.json#/definitions/lockedFactorNumber"
            }
          }
        }
      },
      "else": {
        "properties": {
          "locked": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
