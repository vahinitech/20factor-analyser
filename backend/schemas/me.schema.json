{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/me.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "access",
    "practice"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "access": {
      "$ref": "common.schema.json#/definitions/access"
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas_max",
        "exercises_max",
        "tips_max"
      ],
      "properties": {
        "areas_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "exercises_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "tips_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "description": "How many skills get practice in one report, and how many exercises and tips each shows, for the caller's tier (practice_catalog.TIERS)."
    }
  },
  "title": "GET /api/v2/me response"
}
