{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detail"
  ],
  "properties": {
    "detail": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "description": "429: the free tier's daily checks for this connection are used (daily_limit.py).",
          "required": [
            "error_code",
            "error",
            "limit"
          ],
          "additionalProperties": false,
          "properties": {
            "error_code": {
              "const": "daily_limit"
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "description": "413 or 422: the request's profile was refused (backend/languages/profile.py). field names where, never what the profile holds.",
          "required": [
            "error_code",
            "error",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "error_code": {
              "enum": [
                "profile_empties_class",
                "profile_field_not_allowed",
                "profile_invalid",
                "profile_list_too_long",
                "profile_not_in_pack",
                "profile_not_json",
                "profile_too_large"
              ]
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "description": "422: the request's age_band is not two whole-year ages, the first below the second.",
          "required": [
            "error_code",
            "error",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "error_code": {
              "const": "age_band_invalid"
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "const": "age_band"
            }
          }
        },
        {
          "type": "object",
          "description": "422: a free check did not say who is checking (backend/server/who_checks.py, DPDP Rules rule 10), where the server requires it.",
          "required": [
            "error_code",
            "error",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "error_code": {
              "const": "who_required"
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "const": "who"
            }
          }
        },
        {
          "type": "object",
          "description": "404 from POST /api/v2/compare: the receipt for this side opens no record (unknown, expired, deleted or a wrong token).",
          "required": [
            "error_code",
            "error",
            "side"
          ],
          "additionalProperties": false,
          "properties": {
            "error_code": {
              "const": "no_such_report"
            },
            "error": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "enum": [
                "before",
                "after"
              ]
            }
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "description": "FastAPI request validation errors.",
          "items": {
            "type": "object",
            "required": [
              "loc",
              "msg",
              "type"
            ],
            "properties": {
              "loc": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "msg": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "input": {},
              "ctx": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "title": "HTTP error body for /api/v2/* (400, 401, 403, 404, 413, 422, 429, 503) and /internal/access/v1/* (401, 404, 422, 503)",
  "description": "FastAPI's HTTPException shape. 401 invalid or revoked credential, 403 paid include= fields requested by Free or a comparison asked without Pro, 400 a comparison without exactly two different receipts, 404 unknown catalogue version or stored report, 413 upload or profile too large, 422 unsupported include field, invalid form/query, a refused profile or age_band (detail.error_code says which), 429 the free tier's daily checks for this connection are used (a Pro key is never limited; Retry-After gives the seconds to midnight, India time), 503 subscription service not configured or unavailable. Analysis failures are not HTTP errors: they return 200 with ok:false and an error block in the report schema. The internal access API answers 404 Not Found when it is switched off or the request came through a proxy, 401 for a wrong token, 404 for an unknown customer, key id or secret, 422 for a body it refuses (unknown field, wrong type, Pro without an expiry) and 503 when the ledger is not configured or unavailable."
}
