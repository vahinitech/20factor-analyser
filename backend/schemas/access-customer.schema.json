{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/access-customer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_id",
    "tier",
    "status",
    "expires_at",
    "updated_at",
    "effective",
    "keys",
    "audit"
  ],
  "properties": {
    "customer_id": {
      "$ref": "access-customer.schema.json#/definitions/customerId"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "pro"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired",
        "revoked"
      ]
    },
    "expires_at": {
      "$ref": "common.schema.json#/definitions/unixSeconds"
    },
    "updated_at": {
      "$ref": "access-customer.schema.json#/definitions/expiry"
    },
    "effective": {
      "$ref": "access-customer.schema.json#/definitions/effective"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "revoked",
          "created_at"
        ],
        "properties": {
          "key_id": {
            "$ref": "access-customer.schema.json#/definitions/keyId"
          },
          "revoked": {
            "type": "boolean"
          },
          "created_at": {
            "$ref": "access-customer.schema.json#/definitions/expiry"
          }
        }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "created_at"
        ],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^(subscription|key):",
            "description": "subscription:<tier>:<status>:<expiry>, key:issue:<key id> or key:revoke:<key id>."
          },
          "created_at": {
            "$ref": "access-customer.schema.json#/definitions/expiry"
          }
        }
      }
    }
  },
  "title": "Internal access API customer record: GET /customers/{id}, PUT /customers/{id}/subscription, POST /keys/{id}/revoke",
  "description": "Stored plan, effective access, every key with its revoked flag and the audit history. Never a key secret or digest. Also holds the definitions the other access-* files use.",
  "definitions": {
    "customerId": {
      "type": "string",
      "pattern": "^cus_[0-9a-f]{24}$",
      "description": "Opaque ledger identity."
    },
    "keyId": {
      "type": "string",
      "pattern": "^key_[0-9a-f]{24}$",
      "description": "Names a key; never the secret or its digest."
    },
    "secret": {
      "type": "string",
      "pattern": "^vh_[A-Za-z0-9_-]{16,}$",
      "maxLength": 200,
      "description": "Customer API key. Shown once when issued; only its SHA-256 digest is stored."
    },
    "expiry": {
      "type": "integer",
      "minimum": 1,
      "description": "UTC Unix seconds."
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "tier",
        "plan_tier",
        "subscription_status",
        "expires_at"
      ],
      "properties": {
        "customer_id": {
          "$ref": "access-customer.schema.json#/definitions/customerId"
        },
        "tier": {
          "$ref": "common.schema.json#/definitions/tier"
        },
        "plan_tier": {
          "$ref": "common.schema.json#/definitions/tier"
        },
        "subscription_status": {
          "type": "string",
          "enum": [
            "active",
            "cancelled",
            "expired",
            "revoked"
          ]
        },
        "expires_at": {
          "$ref": "common.schema.json#/definitions/unixSeconds"
        }
      },
      "description": "The access the stored plan gives now, computed by the same function /api/v2/me uses (effective_access)."
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expires_at"
      ],
      "properties": {
        "expires_at": {
          "$ref": "access-customer.schema.json#/definitions/expiry"
        }
      },
      "title": "POST /internal/access/v1/grants request",
      "description": "A new customer with Pro until expires_at (in the future) and its first key, in one transaction."
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "status"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "free",
            "pro"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "cancelled",
            "expired",
            "revoked"
          ]
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "access-customer.schema.json#/definitions/expiry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "PUT /internal/access/v1/customers/{id}/subscription request",
      "description": "Pro needs an explicit expiry. cancelled keeps access until it; expired and revoked give Free at once."
    },
    "keyLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "access-customer.schema.json#/definitions/secret"
        }
      },
      "title": "POST /internal/access/v1/keys/lookup request",
      "description": "The secret travels in the body, never in a URL."
    }
  }
}
