{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/analyser/v2/common.schema.json",
  "title": "Shared definitions for the Vahini report API, version 2",
  "description": "Referenced by the endpoint schemas with $ref. Generated by backend/generate_schemas.py from report_contract.FACTOR_IDS, entitlements.FREE_FACTORS and report_contract.SENSOR_LIMITATIONS; do not edit by hand.",
  "definitions": {
    "factorNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "factorId": {
      "type": "string",
      "enum": [
        "letter_formation",
        "stroke_order",
        "loop_closure",
        "line_quality",
        "size_consistency",
        "ascender_descender_control",
        "baseline_alignment",
        "word_spacing",
        "letter_spacing",
        "margin_discipline",
        "line_straightness",
        "vertical_alignment",
        "speed_consistency",
        "pressure_consistency",
        "stroke_continuity",
        "pen_lift_frequency",
        "slant_consistency",
        "legibility",
        "character_distinction",
        "overall_neatness"
      ]
    },
    "factorIdentity": {
      "description": "number and id must name the same factor.",
      "oneOf": [
        {
          "properties": {
            "number": {
              "const": 1
            },
            "id": {
              "const": "letter_formation"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 2
            },
            "id": {
              "const": "stroke_order"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 3
            },
            "id": {
              "const": "loop_closure"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 4
            },
            "id": {
              "const": "line_quality"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 5
            },
            "id": {
              "const": "size_consistency"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 6
            },
            "id": {
              "const": "ascender_descender_control"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 7
            },
            "id": {
              "const": "baseline_alignment"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 8
            },
            "id": {
              "const": "word_spacing"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 9
            },
            "id": {
              "const": "letter_spacing"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 10
            },
            "id": {
              "const": "margin_discipline"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 11
            },
            "id": {
              "const": "line_straightness"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 12
            },
            "id": {
              "const": "vertical_alignment"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 13
            },
            "id": {
              "const": "speed_consistency"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 14
            },
            "id": {
              "const": "pressure_consistency"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 15
            },
            "id": {
              "const": "stroke_continuity"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 16
            },
            "id": {
              "const": "pen_lift_frequency"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 17
            },
            "id": {
              "const": "slant_consistency"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 18
            },
            "id": {
              "const": "legibility"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 19
            },
            "id": {
              "const": "character_distinction"
            }
          }
        },
        {
          "properties": {
            "number": {
              "const": 20
            },
            "id": {
              "const": "overall_neatness"
            }
          }
        }
      ]
    },
    "freeFactorNumbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "enum": [
          1,
          5,
          7,
          8,
          18
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "lockedFactorNumber": {
      "type": "integer",
      "enum": [
        2,
        3,
        4,
        6,
        9,
        10,
        11,
        12,
        13,
        14,
        15,
        16,
        17,
        19,
        20
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "pro"
      ]
    },
    "subscriptionStatus": {
      "type": "string",
      "enum": [
        "anonymous",
        "active",
        "cancelled",
        "expired",
        "revoked"
      ]
    },
    "unixSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sectionId": {
      "type": "string",
      "enum": [
        "structure",
        "spatial",
        "dynamics",
        "style"
      ]
    },
    "band": {
      "type": "string",
      "enum": [
        "strong",
        "good",
        "dev",
        "focus"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "estimated",
        "proxy",
        "measured",
        "unavailable"
      ]
    },
    "statusCode": {
      "type": "string",
      "enum": [
        "e",
        "p",
        "m",
        "u"
      ]
    },
    "scoreOutOfTen": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10,
      "description": "Original score. null means no score, never 0."
    },
    "scoreOutOfHundred": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{20}$",
      "description": "First 20 hex characters of the SHA-256 of the catalogue body without its version field."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_numbers",
        "detailed_evidence",
        "coaching",
        "personalised_worksheets"
      ],
      "properties": {
        "factor_numbers": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/factorNumber"
          },
          "uniqueItems": true,
          "minItems": 5,
          "maxItems": 20
        },
        "detailed_evidence": {
          "type": "boolean"
        },
        "coaching": {
          "type": "boolean"
        },
        "personalised_worksheets": {
          "type": "boolean"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "authenticated",
        "tier",
        "plan_tier",
        "subscription_status",
        "expires_at",
        "capabilities"
      ],
      "properties": {
        "customer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Opaque ledger identity; the provisioner issues cus_ plus 24 hex characters."
        },
        "authenticated": {
          "type": "boolean"
        },
        "tier": {
          "$ref": "common.schema.json#/definitions/tier"
        },
        "plan_tier": {
          "$ref": "common.schema.json#/definitions/tier"
        },
        "subscription_status": {
          "$ref": "common.schema.json#/definitions/subscriptionStatus"
        },
        "expires_at": {
          "$ref": "common.schema.json#/definitions/unixSeconds"
        },
        "capabilities": {
          "$ref": "common.schema.json#/definitions/capabilities"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authenticated": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "customer_id": {
                "type": "null"
              },
              "tier": {
                "const": "free"
              },
              "subscription_status": {
                "const": "anonymous"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "authenticated": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "customer_id": {
                "type": "string"
              },
              "subscription_status": {
                "not": {
                  "const": "anonymous"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "const": "pro"
              }
            }
          },
          "then": {
            "properties": {
              "expires_at": {
                "type": "integer"
              },
              "plan_tier": {
                "const": "pro"
              },
              "capabilities": {
                "properties": {
                  "factor_numbers": {
                    "minItems": 20
                  },
                  "detailed_evidence": {
                    "const": true
                  },
                  "coaching": {
                    "const": true
                  },
                  "personalised_worksheets": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "capabilities": {
                "properties": {
                  "factor_numbers": {
                    "$ref": "common.schema.json#/definitions/freeFactorNumbers"
                  },
                  "detailed_evidence": {
                    "const": false
                  },
                  "coaching": {
                    "const": false
                  },
                  "personalised_worksheets": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "coachingCard": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "pillar",
        "title",
        "text",
        "why"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "coach",
            "fun"
          ]
        },
        "pillar": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "factorRegions": {
      "type": "object",
      "description": "Keyed by factor number as a string. Present only when evidence is requested: all twenty factors for Pro, the five Free factors otherwise. Sensor-only factors carry status 'unavailable' with an empty url.",
      "propertyNames": {
        "pattern": "^([1-9]|1[0-9]|20)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "url",
          "caption"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^(data:image/(jpeg|png|webp);base64,|$)"
          },
          "caption": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "measurement",
              "context",
              "unavailable"
            ]
          },
          "bbox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "source_size": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "coordinate_space": {
            "type": "string",
            "enum": [
              "processed-image"
            ]
          },
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection_method": {
            "type": "string"
          },
          "places": {
            "type": "array",
            "description": "Free skills 1, 5, 7, 8 and 18: up to three measurements that stand apart from the page ('look') and at most one closest to it ('keep'), each with its box. Ranked by deviation, which is not a probability. backend/marked_places.py.",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bbox",
                "kind",
                "role",
                "region_id",
                "measure",
                "value",
                "reference",
                "deviation",
                "direction",
                "line_confidence"
              ],
              "properties": {
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "kind": {
                  "enum": [
                    "line",
                    "word",
                    "gap"
                  ]
                },
                "role": {
                  "enum": [
                    "look",
                    "keep"
                  ]
                },
                "region_id": {
                  "type": "string"
                },
                "measure": {
                  "enum": [
                    "line_height",
                    "word_xheight",
                    "line_angle",
                    "read_confidence",
                    "word_gap"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "reference": {
                  "type": "number"
                },
                "deviation": {
                  "type": "number",
                  "minimum": 0
                },
                "direction": {
                  "enum": [
                    "taller",
                    "shorter",
                    "even",
                    "tilted",
                    "level",
                    "unclear",
                    "clear",
                    "wider",
                    "narrower"
                  ]
                },
                "line_confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "from_factor": {
                  "enum": [
                    1,
                    5,
                    7,
                    8
                  ]
                }
              }
            }
          },
          "location_url": {
            "type": "string",
            "pattern": "^(data:image/(jpeg|png|webp);base64,|$)"
          },
          "marks": {
            "type": "array",
            "description": "Where this factor was measured, in the uploaded photo's pixels (evidence photo_width x photo_height; scale by your copy's width / photo_width). Boxes are [x, y, w, h], lines two [x, y] points. Roles: region (the evidence crop), look and keep (places), baseline and midline (a fitted line), usual_start (the usual left edge), hardest_line, underline and letter (the line and letters the reader was least sure of). Absent when the photo's size is unknown. backend/comparison_data.py.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shape",
                "role"
              ],
              "properties": {
                "shape": {
                  "enum": [
                    "box",
                    "line"
                  ]
                },
                "role": {
                  "enum": [
                    "region",
                    "look",
                    "keep",
                    "baseline",
                    "midline",
                    "usual_start",
                    "hardest_line",
                    "underline",
                    "letter"
                  ]
                },
                "measure": {
                  "type": "string"
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "points": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "shape": {
                        "const": "box"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "box"
                    ]
                  },
                  "else": {
                    "required": [
                      "points"
                    ]
                  }
                }
              ]
            }
          }
        },
        "if": {
          "properties": {
            "url": {
              "const": ""
            }
          }
        },
        "then": {
          "properties": {
            "status": {
              "const": "unavailable"
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "sectionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "score",
        "normalized",
        "weight",
        "factor_count",
        "scored_factor_count"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/definitions/sectionId"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "$ref": "common.schema.json#/definitions/scoreOutOfTen"
        },
        "normalized": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "factor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "scored_factor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "description": "One of the four sections as the engine scored it (scoring.build_analysis): the mean of its measured factors, 0-10 with one decimal, null when none was measured. weight is what the overall score used (0 for a section with no score). Pro only, since the mean includes factors Free cannot see."
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "words",
        "characters",
        "script",
        "languages",
        "printed_lines",
        "page",
        "reading",
        "passage_aligned",
        "ruleset"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "characters": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "script": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "latin",
            "telugu",
            "devanagari",
            "mixed",
            "other",
            null
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "printed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "string",
          "enum": [
            "handwriting",
            "handwriting_with_print"
          ]
        },
        "reading": {
          "$ref": "common.schema.json#/definitions/recognitionMetadata/properties/level"
        },
        "passage_aligned": {
          "type": "boolean"
        },
        "ruleset": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Facts that say whether two pages can be compared: handwriting lines scored, words and non-space characters read (null when nothing was read), the script of the letters read, the reading engine languages, printed lines found and left out, the reading level, whether a copied passage was matched, and the hash of the rules the page was scored by (see ruleset; a different hash compares like a different script). Counts only: no text or identifier. Every tier, successful reports only."
    },
    "ruleset": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the rules the page was scored by: the language pack the scorer reads and the request's profile (backend/languages/profile.py). Without a profile it is the pack's own hash. Never the profile itself."
    },
    "recognitionMetadata": {
      "type": "object",
      "properties": {
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "ocr_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "hand_lines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "printed_lines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reliable_lines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mean_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_pct": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "refined_by": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "refined_lines": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "passage-verified",
            "high",
            "moderate",
            "low",
            "unavailable",
            null
          ]
        },
        "assistive_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "passage_aligned": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "passage_match": {},
        "note": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
