{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vahinitech.com/schemas/language-pack.schema.json",
  "title": "Language pack",
  "description": "A pack file: facts under set, add and remove (docs/20-languages.md, section 4). definitions/resolved is the pack after inheritance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind"],
  "properties": {
    "$comment": {"type": "string"},
    "id": {"$ref": "#/definitions/id"},
    "kind": {"enum": ["script", "language", "locale"]},
    "extends": {"$ref": "#/definitions/id"},
    "set": {"$ref": "#/definitions/setFields"},
    "add": {"$ref": "#/definitions/listFields"},
    "remove": {"$ref": "#/definitions/listFields"}
  },
  "if": {"properties": {"kind": {"const": "script"}}},
  "then": {
    "not": {
      "anyOf": [
        {"required": ["extends"]},
        {"required": ["add"]},
        {"required": ["remove"]}
      ]
    }
  },
  "else": {"required": ["extends"]},
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^([A-Z][a-z]{3}|[a-z]{2,3}|[a-z]{2,3}-[A-Z]{2})$"
    },
    "path": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"},
    "setFields": {
      "type": "object",
      "propertyNames": {"$ref": "#/definitions/path"}
    },
    "listFields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/path"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "array", "minItems": 1}
        ]
      }
    },
    "letters": {"type": "string"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
    "words": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "chain",
        "script",
        "name",
        "unicode",
        "unit",
        "direction",
        "classes"
      ],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "kind": {"enum": ["script", "language", "locale"]},
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/id"}
        },
        "script": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "name": {"type": "string", "minLength": 1},
        "unicode": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]{4,6}-[0-9A-F]{4,6}$"
          }
        },
        "unit": {"enum": ["letter", "akshara"]},
        "direction": {"enum": ["ltr", "rtl"]},
        "zones": {"type": "array", "items": {"type": "string"}},
        "min_script_share": {"type": "number", "minimum": 0, "maximum": 1},
        "classes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/letters"}
        },
        "tbar_pairs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/words"}
        },
        "letter_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/name"}
        },
        "variants": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 1},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/definitions/name"}
          }
        },
        "level": {"type": "integer", "minimum": 0, "maximum": 3},
        "benchmark": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "letters_per_word": {"type": "number", "exclusiveMinimum": 0},
        "finishing": {"$ref": "#/definitions/letters"},
        "form_words": {"$ref": "#/definitions/words"},
        "reading": {
          "description": "Acceptance limits for reading a line (docs/20-languages.md, section 17.3). accept_confidence: a rung's reading is accepted when that rung's confidence reaches it and the letters are in the script (min_script_share). Unset, a reading is accepted at the top rung of the ladder only, so every line climbs the whole ladder. Set only from rank_stages.py's calibration on benchmark sets (section 19, gap 5).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accept_confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["language", "locale"]}}},
          "then": {"required": ["language", "level"]}
        },
        {
          "if": {
            "required": ["level"],
            "properties": {"level": {"minimum": 1}}
          },
          "then": {"required": ["benchmark"]}
        }
      ]
    }
  }
}
