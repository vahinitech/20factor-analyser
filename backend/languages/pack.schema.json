{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vahinitech.com/schemas/language-pack.schema.json",
  "title": "Language pack",
  "description": "A pack file: facts under set, add and remove (docs/20-languages.md, section 4). $defs/resolved is the pack after inheritance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind"],
  "properties": {
    "$comment": {"type": "string"},
    "id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["script", "language", "locale"]},
    "extends": {"$ref": "#/$defs/id"},
    "set": {"$ref": "#/$defs/setFields"},
    "add": {"$ref": "#/$defs/listFields"},
    "remove": {"$ref": "#/$defs/listFields"}
  },
  "if": {"properties": {"kind": {"const": "script"}}},
  "then": {
    "not": {
      "anyOf": [
        {"required": ["extends"]},
        {"required": ["add"]},
        {"required": ["remove"]}
      ]
    }
  },
  "else": {"required": ["extends"]},
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^([A-Z][a-z]{3}|[a-z]{2,3}|[a-z]{2,3}-[A-Z]{2})$"
    },
    "path": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"},
    "setFields": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/path"}
    },
    "listFields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/path"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "array", "minItems": 1}
        ]
      }
    },
    "letters": {"type": "string"},
    "words": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "chain",
        "script",
        "name",
        "unicode",
        "unit",
        "direction",
        "classes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["script", "language", "locale"]},
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "script": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "name": {"type": "string", "minLength": 1},
        "unicode": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]{4,6}-[0-9A-F]{4,6}$"
          }
        },
        "unit": {"enum": ["letter", "akshara"]},
        "direction": {"enum": ["ltr", "rtl"]},
        "zones": {"type": "array", "items": {"type": "string"}},
        "min_script_share": {"type": "number", "minimum": 0, "maximum": 1},
        "classes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/letters"}
        },
        "tbar_pairs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/words"}
        },
        "level": {"type": "integer", "minimum": 0, "maximum": 3},
        "benchmark": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "letters_per_word": {"type": "number", "exclusiveMinimum": 0},
        "finishing": {"$ref": "#/$defs/letters"},
        "form_words": {"$ref": "#/$defs/words"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["language", "locale"]}}},
          "then": {"required": ["language", "level"]}
        },
        {
          "if": {
            "required": ["level"],
            "properties": {"level": {"minimum": 1}}
          },
          "then": {"required": ["benchmark"]}
        }
      ]
    }
  }
}
